# Development environment template for ledgercore-distributed (copy to .env.development — never commit real secrets)
LEDGERCORE_ENV=development
LEDGERCORE_PORT=8096
LEDGERCORE_SQLITE_PATH=./.data/ledgercore_dev.sqlite3
POSTGRES_URL=postgresql://ledger_dev:ledger_dev_local@localhost:5441/ledgercore_dev
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
REDIS_URL=redis://localhost:6381/0
