# Production environment template for ledgercore-distributed (copy to .env.production — NEVER commit real secrets)
LEDGERCORE_ENV=production
LEDGERCORE_PORT=8096
POSTGRES_URL=postgresql://__PROD_POSTGRES_USER__:__PROD_POSTGRES_PASSWORD__@__PROD_POSTGRES_HOST__:5432/ledgercore_prod?sslmode=require
KAFKA_BOOTSTRAP_SERVERS=__PROD_KAFKA_BROKER_1__:9093,__PROD_KAFKA_BROKER_2__:9093
REDIS_URL=rediss://:__PROD_REDIS_PASSWORD__@__PROD_REDIS_HOST__:6379/0
